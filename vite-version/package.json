{
  "name": "vite-version",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "prebuild": "bun scripts/prebuild-content.ts",
    "build": "bun run prebuild && vite build",
    "build:only": "vite build",
    "build:static": "bun scripts/generate-static.ts",
    "build:hybrid": "bun scripts/build-hybrid.ts",
    "optimize:walrus": "bun scripts/optimize-walrus.ts",
    "build:walrus": "bun run build:hybrid && bun run optimize:walrus",
    "preview": "vite preview",
    "preview:hybrid": "bun scripts/serve-hybrid.ts",
    "test:build": "bun run build:walrus && bun run preview:hybrid",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@tailwindcss/typography": "0.5.10",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "10.4.17",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "postcss": "8.4.33",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "3.4.1",
    "unified": "^11.0.5",
    "vite": "^7.0.5"
  }
}